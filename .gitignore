# IDE & Code Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
nbproject/
*.swp
*.swo
*~

# Package Manager & Dependency Directories
vendor/
node_modules/

# Environment Configurations & Secret Overrides
.env
.env.local
.env.production

