{% extends 'base.html.twig' %}

{% block title %}Staff - Manage Products{% endblock %}

{% block body %}
<section style="background: #0369a1; color: #fff; padding: 2rem 1.5rem 1.5rem;">
    <div style="max-width: var(--max-width, 1200px); margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <span style="color: #bae6fd; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px;">Staff Panel → Catalog</span>
            <h1 style="font-family: var(--font-serif); font-size: 2rem; margin: 0.25rem 0;">Product Records Management</h1>
            <p style="color: #e0f2fe; margin: 0; font-size: 0.9rem;">You can create new products and edit/delete your own created records. Admin & other staff records are view-only.</p>
        </div>
        <a href="{{ path('app_staff_dashboard') }}" style="background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.3); padding: 0.6rem 1.25rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem; text-decoration: none;">← Staff Dashboard</a>
    </div>
</section>

<section style="max-width: var(--max-width, 1200px); margin: 2rem auto 5rem; padding: 0 1.5rem;">
    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; align-items: start;">

        {# Create Product Form — Staff Feature #}
        <div style="background: #fff; border-radius: 12px; box-shadow: var(--shadow-sm); padding: 1.5rem;">
            <h3 style="font-family: var(--font-serif); color: var(--color-brown-deep); margin: 0 0 1.25rem;">+ Create New Product</h3>
            <form method="POST" action="{{ path('app_staff_products') }}" enctype="multipart/form-data" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('staff_product_create') }}">

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.3rem; font-size: 0.9rem;">Product Name <span style="color: #dc2626;">*</span></label>
                    <input type="text" name="name" required maxlength="150" placeholder="e.g. Sourdough Loaf"
                        style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid #ddd; border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.3rem; font-size: 0.9rem;">Category <span style="color: #dc2626;">*</span></label>
                    <select name="category_id" required style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid #ddd; border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                        <option value="">Select category…</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}">{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1rem;">
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 0.3rem; font-size: 0.9rem;">Price (₱) <span style="color: #dc2626;">*</span></label>
                        <input type="number" name="price" step="0.01" min="0.01" required placeholder="0.00"
                            style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid #ddd; border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; margin-bottom: 0.3rem; font-size: 0.9rem;">Stock</label>
                        <input type="number" name="stock" min="0" value="10"
                            style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid #ddd; border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                    </div>
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.3rem; font-size: 0.9rem;">Product Picture (Optional)</label>
                    <input type="file" name="image_file" accept="image/*" style="width: 100%; font-size: 0.82rem;">
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; margin-bottom: 0.3rem; font-size: 0.9rem;">Description</label>
                    <textarea name="description" rows="2" placeholder="Product details…"
                        style="width: 100%; padding: 0.6rem 0.8rem; border: 1px solid #ddd; border-radius: 6px; font-size: 0.9rem; box-sizing: border-box; resize: vertical;"></textarea>
                </div>

                <button type="submit"
                    style="width: 100%; background: #0369a1; color: #fff; padding: 0.75rem; border: none; border-radius: 8px; font-size: 0.95rem; font-weight: 700; cursor: pointer;">
                    Create Record
                </button>
            </form>
        </div>

        {# Products Records List #}
        <div>
            {# Search & Scope Controls #}
            <div style="display: flex; gap: 0.75rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
                <form method="GET" style="display: flex; gap: 0.5rem; flex: 1;">
                    <input type="hidden" name="scope" value="{{ filter_scope|default('all') }}">
                    <input type="text" name="search" value="{{ search }}" placeholder="Search products…"
                        style="flex: 1; padding: 0.6rem 1rem; border: 1px solid #ddd; border-radius: 8px; font-size: 0.9rem;">
                    <button type="submit" style="background: #0369a1; color: #fff; padding: 0.6rem 1.2rem; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">Search</button>
                </form>

                <div style="display: flex; gap: 0.4rem;">
                    <a href="{{ path('app_staff_products', {scope: 'all', search: search}) }}"
                       style="padding: 0.6rem 0.9rem; border-radius: 8px; text-decoration: none; font-size: 0.85rem; font-weight: 600; {{ filter_scope != 'mine' ? 'background: #0369a1; color: #fff;' : 'background: #e2e8f0; color: #334155;' }}">All Records</a>
                    <a href="{{ path('app_staff_products', {scope: 'mine', search: search}) }}"
                       style="padding: 0.6rem 0.9rem; border-radius: 8px; text-decoration: none; font-size: 0.85rem; font-weight: 600; {{ filter_scope == 'mine' ? 'background: #0369a1; color: #fff;' : 'background: #e2e8f0; color: #334155;' }}">My Records Only</a>
                </div>
            </div>

            <div style="background: #fff; border-radius: 12px; box-shadow: var(--shadow-sm); overflow: hidden;">
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background: #f0f9ff; border-bottom: 2px solid rgba(3,105,161,0.1); font-size: 0.8rem; color: var(--color-text-subtle); text-transform: uppercase; text-align: left;">
                                <th style="padding: 10px 1rem;">Product</th>
                                <th style="padding: 10px 1rem;">Category</th>
                                <th style="padding: 10px 1rem;">Price</th>
                                <th style="padding: 10px 1rem;">Creator</th>
                                <th style="padding: 10px 1rem;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for product in products %}
                                {% set is_my_product = product.createdBy and product.createdBy.id == app.user.id %}
                                <tr style="border-bottom: 1px solid rgba(43,27,21,0.05); font-size: 0.88rem; {% if is_my_product %}background: #f8fafc;{% endif %}">
                                    <td style="padding: 12px 1rem;">
                                        <div style="font-weight: 600;">{{ product.name }}</div>
                                        <div style="font-size: 0.78rem; color: #64748b;">Stock: {{ product.stock }}</div>
                                    </td>
                                    <td style="padding: 12px 1rem; color: var(--color-text-subtle);">{{ product.category.name }}</td>
                                    <td style="padding: 12px 1rem; font-weight: 700;">₱{{ product.price }}</td>
                                    <td style="padding: 12px 1rem;">
                                        {% if is_my_product %}
                                            <span style="background: #dcfce7; color: #166534; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;">You</span>
                                        {% elseif product.createdBy %}
                                            <span style="background: #f1f5f9; color: #475569; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">{{ product.createdBy.name }}</span>
                                        {% else %}
                                            <span style="background: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">Admin / System</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 12px 1rem;">
                                        {% if is_my_product %}
                                            {# Staff CAN edit and delete their own records with confirmation prompt #}
                                            <div style="display: flex; gap: 0.4rem;">
                                                <a href="{{ path('app_staff_product_edit', {id: product.id}) }}"
                                                   style="background: #0369a1; color: #fff; padding: 4px 10px; border-radius: 6px; font-size: 0.78rem; text-decoration: none; font-weight: 600;">Edit</a>
                                                <form method="POST" action="{{ path('app_staff_product_delete', {id: product.id}) }}" style="display: inline;"
                                                      onsubmit="return confirm('Are you sure you want to delete your product \'{{ product.name|e('js') }}\'? This cannot be undone.');">
                                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('staff_product_delete_' ~ product.id) }}">
                                                    <button type="submit" style="background: #991b1b; color: #fff; padding: 4px 10px; border: none; border-radius: 6px; font-size: 0.78rem; cursor: pointer; font-weight: 600;">Delete</button>
                                                </form>
                                            </div>
                                        {% else %}
                                            {# Staff CANNOT edit or delete admin/other staff records #}
                                            <span style="font-size: 0.75rem; color: #94a3b8; font-style: italic;" title="Staff can only edit their own records">🔒 View Only</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" style="padding: 2rem; text-align: center; color: var(--color-text-subtle);">No products found.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <p style="margin-top: 0.75rem; color: var(--color-text-subtle); font-size: 0.85rem;">Showing {{ products|length }} product(s)</p>
        </div>
    </div>
</section>
{% endblock %}
