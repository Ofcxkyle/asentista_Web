{% extends 'base.html.twig' %}

{% block title %}Bakery Menu - Asentista's Bakery{% endblock %}

{% block body %}
<section style="background: var(--color-brown-deep); color: #fff; padding: 3.5rem 1.5rem 2.5rem; text-align: center;">
    <div style="max-width: 800px; margin: 0 auto;">
        <span style="color: var(--color-yellow); text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem; font-weight: 700;">Fresh Daily Offerings</span>
        <h1 style="font-family: var(--font-serif); font-size: 2.8rem; margin: 0.5rem 0 1rem;">Our Complete Menu</h1>
        <p style="color: #EDE0D4; font-size: 1.05rem;">From traditional European sourdough loaves to iced cold brews and Italian coffees.</p>
    </div>
</section>

<section style="max-width: var(--max-width, 1200px); margin: 2rem auto 5rem; padding: 0 1.5rem;">
    {# Filter & Search Controls #}
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.5rem; background: #fff; padding: 1.25rem 1.5rem; border-radius: 12px; box-shadow: var(--shadow-sm);">
        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="{{ path('app_store_menu') }}" class="btn" style="padding: 0.5rem 1.25rem; border-radius: 20px; font-weight: 600; font-size: 0.88rem; {{ current_category is empty ? 'background: var(--color-yellow); color: var(--color-brown-deep);' : 'background: #f5ede6; color: var(--color-brown-deep);' }}">All Items</a>
            {% for cat in categories %}
                <a href="{{ path('app_store_menu', { category: cat.slug }) }}" class="btn" style="padding: 0.5rem 1.25rem; border-radius: 20px; font-weight: 600; font-size: 0.88rem; {{ current_category == cat.slug ? 'background: var(--color-yellow); color: var(--color-brown-deep);' : 'background: #f5ede6; color: var(--color-brown-deep);' }}">{{ cat.name }}</a>
            {% endfor %}
        </div>

        <form action="{{ path('app_store_menu') }}" method="GET" style="display: flex; gap: 0.5rem; margin: 0;">
            {% if current_category %}
                <input type="hidden" name="category" value="{{ current_category }}">
            {% endif %}
            <input type="text" name="q" value="{{ search_query|default('') }}" placeholder="Search bread, pastry, coffee..." style="padding: 0.5rem 1rem; border-radius: 6px; border: 1px solid rgba(43,27,21,0.2); font-size: 0.9rem; min-width: 240px;">
            <button type="submit" class="btn" style="background: var(--color-brown-deep); color: #fff; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem; border: none; cursor: pointer;">Search</button>
        </form>
    </div>

    {# Products Grid #}
    {% if products is empty %}
        <div style="background: #fff; padding: 4rem 2rem; border-radius: 12px; text-align: center; box-shadow: var(--shadow-sm);">
            <h3 style="font-family: var(--font-serif); font-size: 1.5rem; color: var(--color-brown-deep); margin-bottom: 0.5rem;">No products found</h3>
            <p style="color: var(--color-text-muted); margin-bottom: 1.5rem;">Try adjusting your category filter or search keywords.</p>
            <a href="{{ path('app_store_menu') }}" class="btn" style="background: var(--color-yellow); color: var(--color-brown-deep); padding: 0.6rem 1.5rem; border-radius: 6px; font-weight: 700; text-decoration: none;">Reset Filters</a>
        </div>
    {% else %}
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem;">
            {% for product in products %}
                <div style="background: #fff; border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-md)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-sm)';">
                    <div style="height: 190px; background: #fdfaf7; display: flex; align-items: center; justify-content: center; padding: 1.25rem; border-bottom: 1px solid rgba(43,27,21,0.06);">
                        <img src="{{ asset(product.image) }}" alt="{{ product.name }}" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                    </div>
                    <div style="padding: 1.25rem; display: flex; flex-direction: column; flex-grow: 1;">
                        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
                            <span style="font-size: 0.75rem; font-weight: 600; color: var(--color-amber-accessible); text-transform: uppercase;">{{ product.category.name }}</span>
                            {% if product.stock <= 0 %}
                                <span style="font-size: 0.8rem; color: #dc2626; font-weight: 700;">Sold Out</span>
                            {% elseif product.stock <= 10 %}
                                <span style="font-size: 0.8rem; color: #b45309; font-weight: 600;">Only {{ product.stock }} left</span>
                            {% else %}
                                <span style="font-size: 0.8rem; color: #166534; font-weight: 600;">{{ product.stock }} in stock</span>
                            {% endif %}
                        </div>
                        <h3 style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-brown-deep); margin-bottom: 0.4rem;">{{ product.name }}</h3>
                        <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">{{ product.description }}</p>

                        <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(43,27,21,0.08); padding-top: 0.85rem;">
                            <span style="font-size: 1.25rem; font-weight: 700; color: var(--color-brown-deep);">₱{{ product.price }}</span>

                            {# Admin cannot order or add to cart. Staff can edit products directly. Customers can add to cart. #}
                            {% if product.stock <= 0 %}
                                <span style="font-size: 0.78rem; background: #fee2e2; color: #dc2626; padding: 4px 8px; border-radius: 4px; font-weight: 700;">Out of Stock</span>
                            {% elseif is_granted('ROLE_ADMIN') %}
                                <span style="font-size: 0.75rem; background: #fee2e2; color: #991b1b; padding: 4px 8px; border-radius: 4px; font-weight: 600;">Admin Mode (No Cart)</span>
                            {% elseif is_granted('ROLE_STAFF') %}
                                <a href="{{ path('app_staff_product_edit', {id: product.id}) }}" style="font-size: 0.8rem; background: #0369a1; color: #fff; padding: 4px 10px; border-radius: 6px; font-weight: 600; text-decoration: none;">Edit Product</a>
                            {% else %}
                                <form action="{{ path('app_cart_add', { id: product.id }) }}" method="POST" style="display: flex; gap: 6px; margin: 0; align-items: center;">
                                    <input type="number" name="quantity" value="1" min="1" max="{{ product.stock }}" style="width: 50px; padding: 4px 6px; border: 1px solid rgba(43,27,21,0.2); border-radius: 4px; text-align: center; font-weight: 600;">
                                    <button type="submit" class="btn" style="background: var(--color-yellow); color: var(--color-brown-deep); padding: 0.45rem 0.85rem; border-radius: 6px; font-weight: 700; font-size: 0.85rem; border: none; cursor: pointer;">+ Add</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>
{% endblock %}
