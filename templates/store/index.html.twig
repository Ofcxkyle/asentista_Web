{% extends 'base.html.twig' %}

{% block title %}Asentista's Bakery - Fresh Handcrafted Breads & Artisan Coffee{% endblock %}

{% block body %}
{# Hero Section #}
<section class="hero-section" style="background: linear-gradient(rgba(43,27,21,0.7), rgba(43,27,21,0.7)), url('{{ asset('assets/AdobeStock_2042265063.png') }}') center/cover no-repeat; color: #fff; padding: 6rem 1.5rem; text-align: center;">
    <div style="max-width: 800px; margin: 0 auto;">
        <span style="color: var(--color-yellow); text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem; font-weight: 700; display: inline-block; margin-bottom: 1rem;">Artisan Baking Tradition</span>
        <h1 style="font-family: var(--font-serif); font-size: 3.2rem; line-height: 1.2; margin-bottom: 1.5rem;">Baked with Passion.<br>Shared with Love.</h1>
        <p style="font-size: 1.15rem; color: #EDE0D4; line-height: 1.7; margin-bottom: 2rem;">Experience the warmth of naturally leavened sourdough, butter-laminated pastries, and expertly roasted coffees brewed fresh all day long.</p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="{{ path('app_store_menu') }}" class="btn" style="background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; padding: 0.85rem 2rem; border-radius: 6px; font-size: 1rem; box-shadow: var(--shadow-md); text-decoration: none;">Explore Our Menu</a>
            <a href="{{ path('app_store_menu', { category: 'bread' }) }}" class="btn" style="background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.4); padding: 0.85rem 1.75rem; border-radius: 6px; font-size: 1rem; backdrop-filter: blur(4px); text-decoration: none;">Fresh Loaves</a>
        </div>
    </div>
</section>

{# Value Pillars #}
<section style="max-width: var(--max-width, 1200px); margin: -2.5rem auto 4rem; padding: 0 1.5rem; position: relative; z-index: 10;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        <div style="background: #fff; padding: 2rem; border-radius: 12px; box-shadow: var(--shadow-md); border-top: 4px solid var(--color-yellow);">
            <h3 style="font-family: var(--font-serif); color: var(--color-brown-deep); font-size: 1.25rem; margin-bottom: 0.75rem;">Natural Levain</h3>
            <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">Our sourdoughs ferment naturally for 36 hours for exceptional digestibility, complex flavor, and caramelized crust.</p>
        </div>
        <div style="background: #fff; padding: 2rem; border-radius: 12px; box-shadow: var(--shadow-md); border-top: 4px solid var(--color-yellow);">
            <h3 style="font-family: var(--font-serif); color: var(--color-brown-deep); font-size: 1.25rem; margin-bottom: 0.75rem;">Premium Ingredients</h3>
            <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">Grass-fed creamery butter, single-estate stoneground flours, and zero synthetic preservatives or additives.</p>
        </div>
        <div style="background: #fff; padding: 2rem; border-radius: 12px; box-shadow: var(--shadow-md); border-top: 4px solid var(--color-yellow);">
            <h3 style="font-family: var(--font-serif); color: var(--color-brown-deep); font-size: 1.25rem; margin-bottom: 0.75rem;">Warmth & Community</h3>
            <p style="color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.6;">Reserve a table for coffee, book special event catering, or have hot loaves delivered directly to your doorstep.</p>
        </div>
    </div>
</section>

{# Featured Breads & Pastries #}
<section style="max-width: var(--max-width, 1200px); margin: 0 auto; padding: 2rem 1.5rem 5rem;">
    <div style="text-align: center; margin-bottom: 3rem;">
        <span style="color: var(--color-amber-accessible); font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.85rem;">Daily Highlights</span>
        <h2 style="font-family: var(--font-serif); font-size: 2.5rem; color: var(--color-brown-deep); margin-top: 0.5rem;">Featured Oven Specialties</h2>
        <div style="width: 60px; height: 3px; background: var(--color-yellow); margin: 1rem auto 0;"></div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem;">
        {% for product in featured_products %}
            <div style="background: #fff; border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm); transition: transform 0.2s, box-shadow 0.2s; display: flex; flex-direction: column;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='var(--shadow-md)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-sm)';">
                <div style="height: 200px; background: #fdfaf7; display: flex; align-items: center; justify-content: center; padding: 1.5rem; border-bottom: 1px solid rgba(43,27,21,0.06);">
                    <img src="{{ asset(product.image) }}" alt="{{ product.name }}" style="max-height: 100%; max-width: 100%; object-fit: contain;">
                </div>
                <div style="padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
                        <span style="font-size: 0.8rem; font-weight: 600; color: var(--color-amber-accessible); text-transform: uppercase;">{{ product.category.name }}</span>
                        <span style="font-size: 0.85rem; color: #166534; font-weight: 600;">{{ product.stock }} in stock</span>
                    </div>
                    <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--color-brown-deep); margin-bottom: 0.5rem;">{{ product.name }}</h3>
                    <p style="font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 1.25rem; flex-grow: 1;">{{ product.description|slice(0, 85) }}...</p>
                    <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid rgba(43,27,21,0.08); padding-top: 1rem;">
                        <span style="font-size: 1.3rem; font-weight: 700; color: var(--color-brown-deep);">₱{{ product.price }}</span>

                        {# Admin cannot order or add to cart. Staff can edit directly. Customers can add to cart. #}
                        {% if product.stock <= 0 %}
                            <span style="font-size: 0.78rem; background: #fee2e2; color: #dc2626; padding: 4px 8px; border-radius: 4px; font-weight: 700;">Out of Stock</span>
                        {% elseif is_granted('ROLE_ADMIN') %}
                            <span style="font-size: 0.75rem; background: #fee2e2; color: #991b1b; padding: 4px 8px; border-radius: 4px; font-weight: 600;">Admin Mode</span>
                        {% elseif is_granted('ROLE_STAFF') %}
                            <a href="{{ path('app_staff_product_edit', {id: product.id}) }}" style="font-size: 0.8rem; background: #0369a1; color: #fff; padding: 4px 10px; border-radius: 6px; font-weight: 600; text-decoration: none;">Edit Product</a>
                        {% else %}
                            <form action="{{ path('app_cart_add', { id: product.id }) }}" method="POST" style="margin: 0;">
                                <input type="hidden" name="quantity" value="1">
                                <button type="submit" class="btn" style="background: var(--color-yellow); color: var(--color-brown-deep); padding: 0.5rem 1rem; border-radius: 6px; font-weight: 700; font-size: 0.85rem; border: none; cursor: pointer;">+ Add to Cart</button>
                            </form>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div style="text-align: center; margin-top: 3.5rem;">
        <a href="{{ path('app_store_menu') }}" class="btn" style="background: var(--color-brown-deep); color: #fff; padding: 0.85rem 2.25rem; border-radius: 6px; font-weight: 600; font-size: 1rem; text-decoration: none;">View Complete Menu &amp; Beverages &rarr;</a>
    </div>
</section>
{% endblock %}
