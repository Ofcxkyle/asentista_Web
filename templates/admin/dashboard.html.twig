{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Asentista's Bakery{% endblock %}

{% block body %}
<section style="background: var(--color-brown-deep); color: #fff; padding: 2.5rem 1.5rem 2rem;">
    <div style="max-width: var(--max-width, 1200px); margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <span style="color: var(--color-yellow); font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px;">Control Panel</span>
            <h1 style="font-family: var(--font-serif); font-size: 2.2rem; margin: 0.25rem 0;">Bakery Administration</h1>
            <p style="color: #EDE0D4; margin: 0; font-size: 0.95rem;">Real-time revenue, incoming orders, and inventory monitoring.</p>
        </div>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a href="{{ path('app_admin_orders_export_csv') }}" style="background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.3); padding: 0.6rem 1.25rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem; text-decoration: none;">📊 Export CSV</a>
            <a href="{{ path('app_admin_users') }}" style="background: #7c3aed; color: #fff; font-weight: 700; padding: 0.6rem 1.25rem; border-radius: 6px; font-size: 0.85rem; text-decoration: none;">👥 Manage Users</a>
            <a href="{{ path('app_admin_products') }}" style="background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; padding: 0.6rem 1.25rem; border-radius: 6px; font-size: 0.85rem; text-decoration: none;">+ Manage Products</a>
        </div>
    </div>
</section>

<section style="max-width: var(--max-width, 1200px); margin: 2rem auto 5rem; padding: 0 1.5rem;">

    {# KPI Cards — Rubrics: total users, total staff, total records #}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
        <div style="background: #fff; padding: 1.5rem; border-radius: 12px; box-shadow: var(--shadow-sm); border-left: 5px solid #166534;">
            <div style="color: var(--color-text-subtle); font-size: 0.85rem; text-transform: uppercase; font-weight: 600;">Total Revenue</div>
            <div style="font-size: 1.9rem; font-weight: 800; color: var(--color-brown-deep); margin-top: 4px;">₱{{ stats.revenue|number_format(2) }}</div>
            <div style="font-size: 0.8rem; color: #166534; margin-top: 4px;">From confirmed & completed orders</div>
        </div>

        <div style="background: #fff; padding: 1.5rem; border-radius: 12px; box-shadow: var(--shadow-sm); border-left: 5px solid #0369a1;">
            <div style="color: var(--color-text-subtle); font-size: 0.85rem; text-transform: uppercase; font-weight: 600;">Total Orders</div>
            <div style="font-size: 1.9rem; font-weight: 800; color: var(--color-brown-deep); margin-top: 4px;">{{ stats.totalOrders }}</div>
            <div style="font-size: 0.8rem; color: #0369a1; margin-top: 4px;">Pickup, delivery & dine-in</div>
        </div>

        <div style="background: #fff; padding: 1.5rem; border-radius: 12px; box-shadow: var(--shadow-sm); border-left: 5px solid #7c3aed;">
            <div style="color: var(--color-text-subtle); font-size: 0.85rem; text-transform: uppercase; font-weight: 600;">Total Users</div>
            <div style="font-size: 1.9rem; font-weight: 800; color: var(--color-brown-deep); margin-top: 4px;">{{ total_users }}</div>
            <a href="{{ path('app_admin_users') }}" style="font-size: 0.8rem; color: #7c3aed; margin-top: 4px; display: block;">{{ total_customers }} customers · {{ total_staff }} staff · {{ total_admins }} admin(s)</a>
        </div>

        <div style="background: #fff; padding: 1.5rem; border-radius: 12px; box-shadow: var(--shadow-sm); border-left: 5px solid #b45309;">
            <div style="color: var(--color-text-subtle); font-size: 0.85rem; text-transform: uppercase; font-weight: 600;">Total Products</div>
            <div style="font-size: 1.9rem; font-weight: 800; color: var(--color-brown-deep); margin-top: 4px;">{{ total_products }}</div>
            <a href="{{ path('app_admin_products') }}" style="font-size: 0.8rem; color: #b45309; margin-top: 4px; display: block;">Manage catalog →</a>
        </div>

        <div style="background: #fff; padding: 1.5rem; border-radius: 12px; box-shadow: var(--shadow-sm); border-left: 5px solid var(--color-yellow);">
            <div style="color: var(--color-text-subtle); font-size: 0.85rem; text-transform: uppercase; font-weight: 600;">Pending Orders</div>
            <div style="font-size: 1.9rem; font-weight: 800; color: #b45309; margin-top: 4px;">{{ stats.pendingOrders }}</div>
            <div style="font-size: 0.8rem; color: #b45309; margin-top: 4px;">Awaiting confirmation</div>
        </div>

        <div style="background: #fff; padding: 1.5rem; border-radius: 12px; box-shadow: var(--shadow-sm); border-left: 5px solid #166534;">
            <div style="color: var(--color-text-subtle); font-size: 0.85rem; text-transform: uppercase; font-weight: 600;">Completed Orders</div>
            <div style="font-size: 1.9rem; font-weight: 800; color: var(--color-brown-deep); margin-top: 4px;">{{ stats.completedOrders }}</div>
            <div style="font-size: 0.8rem; color: #166534; margin-top: 4px;">Successfully served</div>
        </div>
    </div>

    {# Admin Quick Links #}
    <div style="background: #fff; border-radius: 12px; box-shadow: var(--shadow-sm); padding: 1.5rem; margin-bottom: 2rem;">
        <h3 style="font-family: var(--font-serif); color: var(--color-brown-deep); margin: 0 0 1rem;">Quick Actions</h3>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="{{ path('app_admin_user_create') }}" style="background: #7c3aed; color: #fff; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.9rem;">+ Create User</a>
            <a href="{{ path('app_admin_users') }}" style="background: #0369a1; color: #fff; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.9rem;">👥 All Users</a>
            <a href="{{ path('app_admin_orders') }}" style="background: #166534; color: #fff; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.9rem;">📋 All Orders</a>
            <a href="{{ path('app_admin_products') }}" style="background: #b45309; color: #fff; padding: 0.6rem 1.2rem; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 0.9rem;">🍞 Products</a>
        </div>
    </div>

    {# Main Grid: Recent Orders & Low Stock #}
    <div style="display: grid; grid-template-columns: 2.2fr 1fr; gap: 2rem; align-items: start;">
        {# Recent Orders #}
        <div style="background: #fff; border-radius: 12px; box-shadow: var(--shadow-sm); overflow: hidden;">
            <div style="padding: 1.25rem 1.5rem; background: #fdfaf7; border-bottom: 1px solid rgba(43,27,21,0.08); display: flex; justify-content: space-between; align-items: center;">
                <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--color-brown-deep); margin: 0;">Recent Orders</h3>
                <a href="{{ path('app_admin_orders') }}" style="color: var(--color-amber-accessible); font-weight: 600; font-size: 0.85rem;">View All &rarr;</a>
            </div>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid rgba(43,27,21,0.08); text-align: left; font-size: 0.8rem; color: var(--color-text-subtle); text-transform: uppercase; background: #faf6f2;">
                            <th style="padding: 10px 1.25rem;">Order</th>
                            <th style="padding: 10px 1rem;">Customer</th>
                            <th style="padding: 10px 1rem;">Type</th>
                            <th style="padding: 10px 1rem;">Total</th>
                            <th style="padding: 10px 1rem;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in recent_orders %}
                            <tr style="border-bottom: 1px solid rgba(43,27,21,0.06); font-size: 0.88rem;">
                                <td style="padding: 12px 1.25rem; font-weight: 700; font-family: monospace;">
                                    <a href="{{ path('app_checkout_success', { orderNumber: order.orderNumber }) }}" style="color: var(--color-brown-deep);">{{ order.orderNumber }}</a>
                                </td>
                                <td style="padding: 12px 1rem;">
                                    <strong>{{ order.customerName }}</strong>
                                    <div style="font-size: 0.78rem; color: var(--color-text-subtle);">{{ order.customerPhone }}</div>
                                </td>
                                <td style="padding: 12px 1rem;">{{ order.orderType }}</td>
                                <td style="padding: 12px 1rem; font-weight: 700;">₱{{ order.totalAmount }}</td>
                                <td style="padding: 12px 1rem;">
                                    {% if order.status == 'Completed' %}
                                        <span style="background: #dcfce7; color: #166534; padding: 2px 7px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;">Completed</span>
                                    {% elseif order.status == 'Confirmed' %}
                                        <span style="background: #e0f2fe; color: #0369a1; padding: 2px 7px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;">Confirmed</span>
                                    {% elseif order.status == 'Cancelled' %}
                                        <span style="background: #fee2e2; color: #991b1b; padding: 2px 7px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;">Cancelled</span>
                                    {% else %}
                                        <span style="background: #fef3c7; color: #92400e; padding: 2px 7px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;">Pending</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" style="padding: 1.5rem; text-align: center; color: var(--color-text-subtle);">No recent orders.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# Low Stock Warnings #}
        <div style="background: #fff; border-radius: 12px; box-shadow: var(--shadow-sm); overflow: hidden;">
            <div style="padding: 1.25rem 1.5rem; background: #fdfaf7; border-bottom: 1px solid rgba(43,27,21,0.08);">
                <h3 style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-brown-deep); margin: 0;">Stock Alert</h3>
            </div>
            <div style="padding: 1rem 1.5rem;">
                {% if low_stock is empty %}
                    <p style="color: #166534; font-size: 0.9rem; margin: 0.5rem 0;">✔ All products have sufficient stock.</p>
                {% else %}
                    <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                        {% for prod in low_stock %}
                            <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(43,27,21,0.06);">
                                <div>
                                    <div style="font-weight: 600; font-size: 0.9rem; color: var(--color-brown-deep);">{{ prod.name }}</div>
                                    <div style="font-size: 0.75rem; color: var(--color-text-subtle);">₱{{ prod.price }} · {{ prod.category.name }}</div>
                                </div>
                                <span style="background: #fee2e2; color: #991b1b; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 700;">{{ prod.stock }} left</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
