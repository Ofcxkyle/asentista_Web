{% extends 'base.html.twig' %}

{% block title %}Manage Products - Admin - Asentista's Bakery{% endblock %}

{% block stylesheets %}
<style>
.modal-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 900;
    align-items: center;
    justify-content: center;
    padding: 1rem;
}
.modal-backdrop.active {
    display: flex;
}
.modal-box {
    background: #fff;
    border-radius: 14px;
    padding: 2rem;
    width: 100%;
    max-width: 520px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    position: relative;
    max-height: 90vh;
    overflow-y: auto;
}
.modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.4rem;
    cursor: pointer;
    color: var(--color-text-muted);
    line-height: 1;
}
</style>
{% endblock %}

{% block body %}
<section style="background: var(--color-brown-deep); color: #fff; padding: 2.5rem 1.5rem 2rem;">
    <div style="max-width: var(--max-width, 1200px); margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <span style="color: var(--color-yellow); font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px;">Inventory Control</span>
            <h1 style="font-family: var(--font-serif); font-size: 2.2rem; margin: 0.25rem 0;">Bakery Product Catalog</h1>
            <p style="color: #EDE0D4; margin: 0; font-size: 0.95rem;">System-wide access: View, create, upload pictures, update stock, and delete catalog records.</p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <a href="{{ path('app_admin_dashboard') }}" style="background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.3); padding: 0.6rem 1.25rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem; text-decoration: none;">← Dashboard</a>
            <a href="{{ path('app_admin_users') }}" style="background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; padding: 0.6rem 1.25rem; border-radius: 6px; font-size: 0.85rem; text-decoration: none;">👥 Manage Users</a>
        </div>
    </div>
</section>

<section style="max-width: var(--max-width, 1200px); margin: 2rem auto 5rem; padding: 0 1.5rem;">
    <div style="display: grid; grid-template-columns: 1.1fr 2.4fr; gap: 2rem; align-items: start;">
        {# Add Product Form with Picture Upload & Choice #}
        <div style="background: #fff; border-radius: 12px; padding: 1.75rem; box-shadow: var(--shadow-sm); border-top: 4px solid var(--color-yellow); position: sticky; top: 80px;">
            <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--color-brown-deep); margin-bottom: 1.25rem;">+ Add New Product</h3>

            <form action="{{ path('app_admin_products') }}" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_product') }}">

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--color-brown-deep);">Product Name *</label>
                    <input type="text" name="name" required placeholder="e.g. Sourdough Rye" style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--color-brown-deep);">Category *</label>
                    <select name="category_id" required style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                        {% for cat in categories %}
                            <option value="{{ cat.id }}">{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 1rem;">
                    <div>
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--color-brown-deep);">Price (₱) *</label>
                        <input type="number" step="0.01" min="0" name="price" required placeholder="0.00" style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--color-brown-deep);">Stock Quantity *</label>
                        <input type="number" min="0" name="stock" value="15" required style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                    </div>
                </div>

                {# Product Picture: Admin Choice (File Upload or Bakery Preset) #}
                <div style="margin-bottom: 1rem; padding: 0.85rem; background: #faf6f2; border: 1px dashed rgba(43,27,21,0.25); border-radius: 8px;">
                    <label style="display: block; font-weight: 700; font-size: 0.88rem; margin-bottom: 4px; color: var(--color-brown-deep);">📷 Product Picture (Admin Choice)</label>
                    <div style="font-size: 0.78rem; color: var(--color-text-subtle); margin-bottom: 8px;">Upload your own custom image file:</div>
                    <input type="file" name="image_file" accept="image/*" style="width: 100%; font-size: 0.82rem; margin-bottom: 8px;">

                    <div style="font-size: 0.78rem; color: var(--color-text-subtle); margin-bottom: 4px;">Or choose from bakery presets:</div>
                    <select name="image" style="width: 100%; padding: 0.5rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.82rem; box-sizing: border-box;">
                        <option value="assets/breads-e1656042972619.png">Bially Bread Roll</option>
                        <option value="assets/bread-with-appetizing-crunchy-crust-top-view-isolated-on-white-e1656042939392.png">Crunchy Crust Bread</option>
                        <option value="assets/top-view-of-crescent-roll-with-poppy-seeds-on-white-background-e1656042946947.png">Crescent Poppy Roll</option>
                        <option value="assets/traditional-round-rye-bread-e1656042958429.png">Round Rye Bread</option>
                        <option value="assets/yeast-bun-with-apple-and-custard-filling-e1656042965940.png">Yeast Custard Bun</option>
                        <option value="assets/bun-e1656042983426.png">Bun Messes Brioche</option>
                        <option value="assets/rye-bread-slice-on-a-white-background--e1656042993568.png">Sliced Rye Loaf</option>
                        <option value="assets/bun-1-e1656043014357.png">Golden Dinner Roll</option>
                        <option value="assets/bread-e1656042861839-pqroqtezjh2g0607d0pphz5ddrx6ppa7b44no9oloo.png">Artisan Baguette</option>
                        <option value="assets/banana-bread-e1656043181560 (1).png">Banana Bread Loaf</option>
                        <option value="assets/cheese-rolls-e1656043205913 (1).png">Cheese Rolls</option>
                        <option value="assets/italian-ciabatta-bread-on-black-slate-with-herbs-and-olives--e1656043199744 (1).png">Italian Ciabatta</option>
                        <option value="assets/AdobeStock_2042265063.png">Artisan Sourdough Specialty</option>
                    </select>
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--color-brown-deep);">Description</label>
                    <textarea name="description" rows="3" placeholder="Handcrafted with levain..." style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.85rem; box-sizing: border-box;"></textarea>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; font-weight: 600; cursor: pointer;">
                        <input type="checkbox" name="is_featured" value="1" checked>
                        <span>Feature on Homepage</span>
                    </label>
                </div>

                <button type="submit" class="btn" style="width: 100%; background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; padding: 0.75rem; border-radius: 6px; font-size: 0.95rem; border: none; cursor: pointer;">Save Product</button>
            </form>
        </div>

        {# Product List #}
        <div style="background: #fff; border-radius: 12px; box-shadow: var(--shadow-sm); overflow: hidden;">
            <div style="padding: 1.25rem 1.5rem; background: #fdfaf7; border-bottom: 1px solid rgba(43,27,21,0.08); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--color-brown-deep); margin: 0;">Product List ({{ products|length }})</h3>

                {# Search form #}
                <form method="GET" style="display: flex; gap: 0.5rem;">
                    <input type="text" name="search" value="{{ search|default('') }}" placeholder="Search products…"
                           style="padding: 0.4rem 0.8rem; border: 1px solid #ddd; border-radius: 6px; font-size: 0.85rem;">
                    <button type="submit" style="background: var(--color-brown-deep); color: #fff; padding: 0.4rem 0.8rem; border: none; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600;">Search</button>
                    {% if search|default('') %}
                        <a href="{{ path('app_admin_products') }}" style="padding: 0.4rem 0.6rem; border: 1px solid #ddd; border-radius: 6px; text-decoration: none; font-size: 0.85rem; color: var(--color-brown-deep);">Reset</a>
                    {% endif %}
                </form>
            </div>

            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 2px solid rgba(43,27,21,0.08); text-align: left; font-size: 0.8rem; color: var(--color-text-subtle); text-transform: uppercase; background: #faf6f2;">
                            <th style="padding: 10px 1.25rem;">Product</th>
                            <th style="padding: 10px 1rem;">Category</th>
                            <th style="padding: 10px 1rem;">Price</th>
                            <th style="padding: 10px 1rem;">Stock</th>
                            <th style="padding: 10px 1rem;">Creator</th>
                            <th style="padding: 10px 1rem;">Featured</th>
                            <th style="padding: 10px 1rem; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                            <tr style="border-bottom: 1px solid rgba(43,27,21,0.06); font-size: 0.88rem;">
                                <td style="padding: 12px 1.25rem;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <img src="{{ asset(product.image) }}" alt="{{ product.name }}" style="width: 44px; height: 44px; object-fit: contain; background: #fdfaf7; border-radius: 6px; padding: 2px; border: 1px solid #eee;">
                                        <strong>{{ product.name }}</strong>
                                    </div>
                                </td>
                                <td style="padding: 12px 1rem; color: var(--color-text-muted);">{{ product.category.name }}</td>
                                <td style="padding: 12px 1rem; font-weight: 700; color: var(--color-brown-deep);">₱{{ product.price }}</td>
                                <td style="padding: 12px 1rem;">
                                    {% if product.stock <= 10 %}
                                        <span style="color: #dc2626; font-weight: 700;">{{ product.stock }} left</span>
                                    {% else %}
                                        <span style="color: #166534; font-weight: 600;">{{ product.stock }}</span>
                                    {% endif %}
                                </td>
                                <td style="padding: 12px 1rem;">
                                    {% if product.createdBy %}
                                        <span style="background: #e0f2fe; color: #0369a1; padding: 2px 7px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">{{ product.createdBy.name }}</span>
                                    {% else %}
                                        <span style="background: #f3f4f6; color: #6b7280; padding: 2px 7px; border-radius: 4px; font-size: 0.75rem;">Admin</span>
                                    {% endif %}
                                </td>
                                <td style="padding: 12px 1rem;">
                                    <form action="{{ path('app_admin_product_toggle_featured', { id: product.id }) }}" method="POST" style="margin: 0;">
                                        <button type="submit" style="font-size: 0.75rem; font-weight: 700; padding: 3px 8px; border-radius: 4px; border: none; cursor: pointer; {{ product.isFeatured ? 'background: #dcfce7; color: #166534;' : 'background: #f3f4f6; color: #6b7280;' }}">
                                            {{ product.isFeatured ? '★ Featured' : '☆ Standard' }}
                                        </button>
                                    </form>
                                </td>
                                <td style="padding: 12px 1rem; text-align: center; white-space: nowrap;">
                                    <button type="button"
                                        onclick="openEditModal({{ product.id }}, '{{ product.name|e('js') }}', '{{ product.category.id }}', '{{ product.price }}', '{{ product.stock }}', '{{ product.description|e('js') }}', {{ product.isFeatured ? 'true' : 'false' }}, '{{ asset(product.image) }}')"
                                        style="background: #eff6ff; color: #1d4ed8; border: none; padding: 4px 10px; border-radius: 4px; font-size: 0.78rem; font-weight: 600; cursor: pointer; margin-right: 4px;">
                                        ✎ Edit
                                    </button>
                                    <button type="button"
                                        onclick="openDeleteModal({{ product.id }}, '{{ product.name|e('js') }}')"
                                        style="background: #fee2e2; color: #dc2626; border: none; padding: 4px 10px; border-radius: 4px; font-size: 0.78rem; font-weight: 600; cursor: pointer;">
                                        🗑 Delete
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

{# Edit Product Modal with Picture Update #}
<div class="modal-backdrop" id="editModal">
    <div class="modal-box">
        <button type="button" class="modal-close" onclick="closeModal('editModal')">&times;</button>
        <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-brown-deep); margin-bottom: 1.25rem;">Edit Product</h3>

        <form id="editForm" method="POST" enctype="multipart/form-data">
            <input type="hidden" id="editCsrf" name="_csrf_token">

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--color-brown-deep);">Product Name *</label>
                <input type="text" id="editName" name="name" required style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
            </div>

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--color-brown-deep);">Category</label>
                <select id="editCategory" name="category_id" style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" data-cat-id="{{ cat.id }}">{{ cat.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 1rem;">
                <div>
                    <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--color-brown-deep);">Price (₱) *</label>
                    <input type="number" step="0.01" min="0" id="editPrice" name="price" required style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                </div>
                <div>
                    <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--color-brown-deep);">Stock Quantity *</label>
                    <input type="number" min="0" id="editStock" name="stock" required style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.9rem; box-sizing: border-box;">
                </div>
            </div>

            {# Picture Edit & Upload #}
            <div style="margin-bottom: 1rem; padding: 0.85rem; background: #faf6f2; border: 1px dashed rgba(43,27,21,0.25); border-radius: 8px;">
                <label style="display: block; font-weight: 700; font-size: 0.88rem; margin-bottom: 4px; color: var(--color-brown-deep);">📷 Update Product Picture</label>
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
                    <img id="editImagePreview" src="" alt="Preview" style="width: 48px; height: 48px; object-fit: contain; background: #fff; border-radius: 6px; border: 1px solid #ddd; padding: 2px;">
                    <span style="font-size: 0.8rem; color: var(--color-text-subtle);">Current product image</span>
                </div>
                <div style="font-size: 0.78rem; color: var(--color-text-subtle); margin-bottom: 4px;">Upload new picture (optional):</div>
                <input type="file" name="image_file" accept="image/*" style="width: 100%; font-size: 0.82rem; margin-bottom: 8px;">
                <div style="font-size: 0.78rem; color: var(--color-text-subtle); margin-bottom: 4px;">Or switch to bakery preset:</div>
                <select name="image" id="editPresetImage" style="width: 100%; padding: 0.5rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.82rem; box-sizing: border-box;">
                    <option value="">-- Keep Current Image --</option>
                    <option value="assets/breads-e1656042972619.png">Bially Bread Roll</option>
                    <option value="assets/bread-with-appetizing-crunchy-crust-top-view-isolated-on-white-e1656042939392.png">Crunchy Crust Bread</option>
                    <option value="assets/top-view-of-crescent-roll-with-poppy-seeds-on-white-background-e1656042946947.png">Crescent Poppy Roll</option>
                    <option value="assets/traditional-round-rye-bread-e1656042958429.png">Round Rye Bread</option>
                    <option value="assets/yeast-bun-with-apple-and-custard-filling-e1656042965940.png">Yeast Custard Bun</option>
                    <option value="assets/bun-e1656042983426.png">Bun Messes Brioche</option>
                    <option value="assets/rye-bread-slice-on-a-white-background--e1656042993568.png">Sliced Rye Loaf</option>
                    <option value="assets/bun-1-e1656043014357.png">Golden Dinner Roll</option>
                    <option value="assets/bread-e1656042861839-pqroqtezjh2g0607d0pphz5ddrx6ppa7b44no9oloo.png">Artisan Baguette</option>
                    <option value="assets/banana-bread-e1656043181560 (1).png">Banana Bread Loaf</option>
                    <option value="assets/cheese-rolls-e1656043205913 (1).png">Cheese Rolls</option>
                    <option value="assets/italian-ciabatta-bread-on-black-slate-with-herbs-and-olives--e1656043199744 (1).png">Italian Ciabatta</option>
                    <option value="assets/AdobeStock_2042265063.png">Artisan Sourdough Specialty</option>
                </select>
            </div>

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 4px; color: var(--color-brown-deep);">Description</label>
                <textarea id="editDescription" name="description" rows="3" style="width: 100%; padding: 0.6rem 0.75rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.85rem; box-sizing: border-box;"></textarea>
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 8px; font-size: 0.88rem; font-weight: 600; cursor: pointer;">
                    <input type="checkbox" id="editFeatured" name="is_featured" value="1">
                    <span>Feature on Storefront Homepage</span>
                </label>
            </div>

            <div style="display: flex; gap: 0.75rem;">
                <button type="submit" class="btn" style="flex: 1; background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; padding: 0.75rem; border-radius: 6px; font-size: 0.95rem; border: none; cursor: pointer;">Save Changes</button>
                <button type="button" onclick="closeModal('editModal')" style="padding: 0.75rem 1.25rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; background: none; cursor: pointer; font-weight: 600; color: var(--color-text-muted);">Cancel</button>
            </div>
        </form>
    </div>
</div>

{# Delete Product Modal (Delete with Confirmation Prompt) #}
<div class="modal-backdrop" id="deleteModal">
    <div class="modal-box" style="max-width: 400px; text-align: center;">
        <div style="font-size: 2.5rem; margin-bottom: 1rem;">🗑️</div>
        <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-brown-deep); margin-bottom: 0.5rem;">Delete Product</h3>
        <p id="deleteMessage" style="color: var(--color-text-muted); margin-bottom: 1.5rem; font-size: 0.95rem;"></p>
        <form id="deleteForm" method="POST">
            <input type="hidden" id="deleteCsrf" name="_csrf_token">
            <div style="display: flex; gap: 0.75rem; justify-content: center;">
                <button type="submit" style="background: #dc2626; color: #fff; border: none; padding: 0.7rem 1.5rem; border-radius: 6px; font-weight: 700; cursor: pointer; font-size: 0.95rem;">Yes, Delete</button>
                <button type="button" onclick="closeModal('deleteModal')" style="padding: 0.7rem 1.25rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; background: none; cursor: pointer; font-weight: 600; color: var(--color-text-muted);">Cancel</button>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
const csrfTokens = {};

// Store CSRF tokens for each product
{% for product in products %}
csrfTokens[{{ product.id }}] = {
    update: '{{ csrf_token("product_update_" ~ product.id) }}',
    delete: '{{ csrf_token("product_delete_" ~ product.id) }}'
};
{% endfor %}

const editPaths = {};
const deletePaths = {};
{% for product in products %}
editPaths[{{ product.id }}] = '{{ path("app_admin_product_update", { id: product.id }) }}';
deletePaths[{{ product.id }}] = '{{ path("app_admin_product_delete", { id: product.id }) }}';
{% endfor %}

function openEditModal(id, name, categoryId, price, stock, description, isFeatured, imageUrl) {
    document.getElementById('editForm').action = editPaths[id];
    document.getElementById('editCsrf').value = csrfTokens[id].update;
    document.getElementById('editName').value = name;
    document.getElementById('editPrice').value = price;
    document.getElementById('editStock').value = stock;
    document.getElementById('editDescription').value = description;
    document.getElementById('editImagePreview').src = imageUrl || '';

    const select = document.getElementById('editCategory');
    for (let i = 0; i < select.options.length; i++) {
        if (select.options[i].value == categoryId) {
            select.selectedIndex = i;
            break;
        }
    }

    document.getElementById('editFeatured').checked = isFeatured;
    document.getElementById('editModal').classList.add('active');
}

function openDeleteModal(id, name) {
    document.getElementById('deleteForm').action = deletePaths[id];
    document.getElementById('deleteCsrf').value = csrfTokens[id].delete;
    document.getElementById('deleteMessage').textContent = 'Are you sure you want to remove "' + name + '" from the product catalog? This action cannot be undone.';
    document.getElementById('deleteModal').classList.add('active');
}

function closeModal(modalId) {
    document.getElementById(modalId).classList.remove('active');
}

// Close on backdrop click
document.querySelectorAll('.modal-backdrop').forEach(modal => {
    modal.addEventListener('click', function(e) {
        if (e.target === this) {
            this.classList.remove('active');
        }
    });
});
</script>
{% endblock %}
