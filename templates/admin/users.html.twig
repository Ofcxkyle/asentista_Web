{% extends 'base.html.twig' %}

{% block title %}User Management - Admin{% endblock %}

{% block body %}
<section style="background: var(--color-brown-deep); color: #fff; padding: 2rem 1.5rem 1.5rem;">
    <div style="max-width: var(--max-width, 1200px); margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <span style="color: var(--color-yellow); font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px;">Admin → User Management</span>
            <h1 style="font-family: var(--font-serif); font-size: 2rem; margin: 0.25rem 0;">All User Accounts</h1>
        </div>
        <a href="{{ path('app_admin_user_create') }}" style="background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; padding: 0.65rem 1.5rem; border-radius: 8px; text-decoration: none; font-size: 0.9rem;">+ Create New User</a>
    </div>
</section>

<section style="max-width: var(--max-width, 1200px); margin: 2rem auto 5rem; padding: 0 1.5rem;">
    {# Search & Filter #}
    <form method="GET" style="display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
        <input type="text" name="search" value="{{ search }}" placeholder="Search by name or email…"
            style="flex: 1; min-width: 200px; padding: 0.6rem 1rem; border: 1px solid #ddd; border-radius: 8px; font-size: 0.9rem;">
        <select name="role" style="padding: 0.6rem 1rem; border: 1px solid #ddd; border-radius: 8px; font-size: 0.9rem;">
            <option value="">All Roles</option>
            <option value="ROLE_CUSTOMER" {{ filter_role == 'ROLE_CUSTOMER' ? 'selected' : '' }}>Customer</option>
            <option value="ROLE_STAFF" {{ filter_role == 'ROLE_STAFF' ? 'selected' : '' }}>Staff</option>
            <option value="ROLE_ADMIN" {{ filter_role == 'ROLE_ADMIN' ? 'selected' : '' }}>Admin</option>
        </select>
        <button type="submit" style="background: var(--color-brown-deep); color: #fff; padding: 0.6rem 1.2rem; border: none; border-radius: 8px; cursor: pointer; font-weight: 600;">Search</button>
        <a href="{{ path('app_admin_users') }}" style="padding: 0.6rem 1rem; border: 1px solid #ddd; border-radius: 8px; text-decoration: none; color: var(--color-brown-deep); font-size: 0.9rem;">Reset</a>
    </form>

    <div style="background: #fff; border-radius: 12px; box-shadow: var(--shadow-sm); overflow: hidden;">
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #faf6f2; border-bottom: 2px solid rgba(43,27,21,0.08); text-align: left; font-size: 0.8rem; color: var(--color-text-subtle); text-transform: uppercase;">
                        <th style="padding: 12px 1rem;">#</th>
                        <th style="padding: 12px 1rem;">Name</th>
                        <th style="padding: 12px 1rem;">Email</th>
                        <th style="padding: 12px 1rem;">Role</th>
                        <th style="padding: 12px 1rem;">Status</th>
                        <th style="padding: 12px 1rem;">Date Created</th>
                        <th style="padding: 12px 1rem;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr style="border-bottom: 1px solid rgba(43,27,21,0.05); font-size: 0.88rem; {% if not user.isActive %}background: #fff5f5;{% endif %}">
                            <td style="padding: 12px 1rem; color: var(--color-text-subtle);">{{ user.id }}</td>
                            <td style="padding: 12px 1rem; font-weight: 600;">{{ user.name }}</td>
                            <td style="padding: 12px 1rem;">{{ user.email }}</td>
                            <td style="padding: 12px 1rem;">
                                {% if 'ROLE_ADMIN' in user.roles %}
                                    <span style="background: #fee2e2; color: #991b1b; padding: 3px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">Admin</span>
                                {% elseif 'ROLE_STAFF' in user.roles %}
                                    <span style="background: #e0f2fe; color: #0369a1; padding: 3px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">Staff</span>
                                {% else %}
                                    <span style="background: #dcfce7; color: #166534; padding: 3px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700;">Customer</span>
                                {% endif %}
                            </td>
                            <td style="padding: 12px 1rem;">
                                {% if user.isActive %}
                                    <span style="background: #dcfce7; color: #166534; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;">Active</span>
                                {% else %}
                                    <span style="background: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 700;">Disabled</span>
                                {% endif %}
                            </td>
                            <td style="padding: 12px 1rem; color: var(--color-text-subtle);">{{ user.createdAt ? user.createdAt|date('M d, Y') : '—' }}</td>
                            <td style="padding: 12px 1rem;">
                                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <a href="{{ path('app_admin_user_edit', {id: user.id}) }}"
                                       style="background: #0369a1; color: #fff; padding: 4px 10px; border-radius: 6px; font-size: 0.78rem; text-decoration: none; font-weight: 600;">Edit</a>

                                    {# Toggle Active #}
                                    <form method="POST" action="{{ path('app_admin_user_toggle_active', {id: user.id}) }}" style="display: inline;">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_toggle_' ~ user.id) }}">
                                        <button type="submit" style="background: {{ user.isActive ? '#b45309' : '#166534' }}; color: #fff; padding: 4px 10px; border: none; border-radius: 6px; font-size: 0.78rem; cursor: pointer; font-weight: 600;">
                                            {{ user.isActive ? 'Disable' : 'Enable' }}
                                        </button>
                                    </form>

                                    {# Delete with confirmation #}
                                    <form method="POST" action="{{ path('app_admin_user_delete', {id: user.id}) }}" style="display: inline;"
                                          onsubmit="return confirm('Are you sure you want to permanently delete the account for {{ user.name|e('js') }}? This action cannot be undone.');">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_user_delete_' ~ user.id) }}">
                                        <button type="submit" style="background: #991b1b; color: #fff; padding: 4px 10px; border: none; border-radius: 6px; font-size: 0.78rem; cursor: pointer; font-weight: 600;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" style="padding: 2rem; text-align: center; color: var(--color-text-subtle);">No users found.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <p style="margin-top: 1rem; color: var(--color-text-subtle); font-size: 0.85rem;">Total: {{ users|length }} user(s)</p>
</section>
{% endblock %}

