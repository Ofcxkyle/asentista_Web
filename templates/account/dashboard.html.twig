{% extends 'base.html.twig' %}

{% block title %}My Customer Dashboard - Asentista's Bakery{% endblock %}

{% block body %}
<section style="background: var(--color-brown-deep); color: #fff; padding: 3rem 1.5rem 2.5rem;">
    <div style="max-width: var(--max-width, 1200px); margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <span style="color: var(--color-yellow); font-weight: 700; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 1.5px;">Customer Portal</span>
            <h1 style="font-family: var(--font-serif); font-size: 2.2rem; margin: 0.25rem 0;">Hello, {{ user.name }}</h1>
            <p style="color: #EDE0D4; margin: 0; font-size: 0.95rem;">Track your bakery reservations, active deliveries, and past purchase receipts.</p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <a href="{{ path('app_account_profile') }}" class="btn" style="background: rgba(255,255,255,0.15); color: #fff; border: 1px solid rgba(255,255,255,0.3); padding: 0.65rem 1.25rem; border-radius: 6px; font-weight: 600; font-size: 0.9rem;">Edit Profile</a>
            <a href="{{ path('app_store_menu') }}" class="btn" style="background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; padding: 0.65rem 1.5rem; border-radius: 6px;">+ New Order / Booking</a>
        </div>
    </div>
</section>

<section style="max-width: var(--max-width, 1200px); margin: 3rem auto 5rem; padding: 0 1.5rem;">
    <div style="display: grid; grid-template-columns: 1fr 3fr; gap: 2rem; align-items: start;">
        {# Profile Card #}
        <div style="background: #fff; border-radius: 12px; padding: 1.75rem; box-shadow: var(--shadow-sm); border-top: 4px solid var(--color-yellow);">
            <div style="width: 60px; height: 60px; background: #fdfaf7; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-serif); font-size: 1.5rem; font-weight: 700; color: var(--color-brown-deep); border: 2px solid var(--color-yellow); margin-bottom: 1rem;">
                {{ user.name|slice(0, 1) }}
            </div>
            <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--color-brown-deep); margin: 0 0 4px;">{{ user.name }}</h3>
            <span style="display: inline-block; background: #dcfce7; color: #166534; font-size: 0.75rem; font-weight: 700; padding: 2px 8px; border-radius: 12px; margin-bottom: 1.25rem;">Bakery Customer</span>

            <div style="border-top: 1px solid rgba(43,27,21,0.08); padding-top: 1rem; font-size: 0.88rem; display: flex; flex-direction: column; gap: 0.75rem;">
                <div>
                    <span style="color: var(--color-text-subtle); display: block; font-size: 0.78rem; text-transform: uppercase;">Email:</span>
                    <strong style="color: var(--color-brown-deep);">{{ user.email }}</strong>
                </div>
                <div>
                    <span style="color: var(--color-text-subtle); display: block; font-size: 0.78rem; text-transform: uppercase;">Phone:</span>
                    <strong style="color: var(--color-brown-deep);">{{ user.phone|default('Not provided') }}</strong>
                </div>
                <div>
                    <span style="color: var(--color-text-subtle); display: block; font-size: 0.78rem; text-transform: uppercase;">Member Since:</span>
                    <strong style="color: var(--color-brown-deep);">{{ user.createdAt|date('M Y') }}</strong>
                </div>
            </div>
        </div>

        {# Order History List #}
        <div style="background: #fff; border-radius: 12px; box-shadow: var(--shadow-sm); overflow: hidden;">
            <div style="padding: 1.25rem 1.5rem; background: #fdfaf7; border-bottom: 1px solid rgba(43,27,21,0.08); display: flex; justify-content: space-between; align-items: center;">
                <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--color-brown-deep); margin: 0;">My Orders &amp; Bookings</h3>
                <span style="font-size: 0.85rem; color: var(--color-text-muted); font-weight: 600;">{{ orders|length }} total orders</span>
            </div>

            {% if orders is empty %}
                <div style="padding: 4rem 2rem; text-align: center;">
                    <p style="color: var(--color-text-muted); font-size: 1rem; margin-bottom: 1.5rem;">You have not placed any orders yet.</p>
                    <a href="{{ path('app_store_menu') }}" class="btn" style="background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; padding: 0.6rem 1.5rem; border-radius: 6px;">Explore Menu &rarr;</a>
                </div>
            {% else %}
                <div style="overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="border-bottom: 2px solid rgba(43,27,21,0.08); text-align: left; font-size: 0.8rem; color: var(--color-text-subtle); text-transform: uppercase; background: #faf6f2;">
                                <th style="padding: 12px 1.5rem;">Order Number</th>
                                <th style="padding: 12px 1rem;">Date</th>
                                <th style="padding: 12px 1rem;">Type</th>
                                <th style="padding: 12px 1rem;">Items</th>
                                <th style="padding: 12px 1rem;">Total</th>
                                <th style="padding: 12px 1rem;">Status</th>
                                <th style="padding: 12px 1.5rem; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders %}
                                <tr style="border-bottom: 1px solid rgba(43,27,21,0.06); font-size: 0.9rem;">
                                    <td style="padding: 14px 1.5rem; font-weight: 700; font-family: monospace; color: var(--color-brown-deep);">{{ order.orderNumber }}</td>
                                    <td style="padding: 14px 1rem; color: var(--color-text-muted);">{{ order.createdAt|date('M d, Y') }}</td>
                                    <td style="padding: 14px 1rem; font-weight: 500;">{{ order.orderType }}</td>
                                    <td style="padding: 14px 1rem; color: var(--color-text-muted);">
                                        {% for item in order.items %}
                                            <div>{{ item.productName }} &times; {{ item.quantity }}</div>
                                        {% endfor %}
                                    </td>
                                    <td style="padding: 14px 1rem; font-weight: 700; color: var(--color-brown-deep);">₱{{ order.totalAmount }}</td>
                                    <td style="padding: 14px 1rem;">
                                        {% if order.status == 'Completed' %}
                                            <span style="background: #dcfce7; color: #166534; padding: 3px 8px; border-radius: 4px; font-size: 0.78rem; font-weight: 700;">Completed</span>
                                        {% elseif order.status == 'Confirmed' %}
                                            <span style="background: #e0f2fe; color: #0369a1; padding: 3px 8px; border-radius: 4px; font-size: 0.78rem; font-weight: 700;">Confirmed</span>
                                        {% elseif order.status == 'Cancelled' %}
                                            <span style="background: #fee2e2; color: #991b1b; padding: 3px 8px; border-radius: 4px; font-size: 0.78rem; font-weight: 700;">Cancelled</span>
                                        {% else %}
                                            <span style="background: #fef3c7; color: #92400e; padding: 3px 8px; border-radius: 4px; font-size: 0.78rem; font-weight: 700;">Pending</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 14px 1.5rem; text-align: right;">
                                        <a href="{{ path('app_account_order_detail', { orderNumber: order.orderNumber }) }}" style="color: var(--color-amber-accessible); font-weight: 600; text-decoration: underline; font-size: 0.85rem;">View Details &rarr;</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
