{% extends 'base.html.twig' %}

{% block title %}Order {{ order.orderNumber }} - My Account - Asentista's Bakery{% endblock %}

{% block body %}
<section style="background: var(--color-brown-deep); color: #fff; padding: 2.5rem 1.5rem 2rem;">
    <div style="max-width: var(--max-width, 1200px); margin: 0 auto; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;">
        <a href="{{ path('app_account_dashboard') }}" style="color: #EDE0D4; font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; gap: 6px;">&larr; Back to My Orders</a>
        <div>
            <h1 style="font-family: var(--font-serif); font-size: 2rem; margin: 0.25rem 0;">Order {{ order.orderNumber }}</h1>
            <p style="color: #EDE0D4; margin: 0; font-size: 0.9rem;">Placed on {{ order.createdAt|date('F j, Y \\a\\t h:i A') }}</p>
        </div>
    </div>
</section>

<section style="max-width: 850px; margin: 3rem auto 5rem; padding: 0 1.5rem;">
    {# Status Banner #}
    <div style="margin-bottom: 2rem; padding: 1rem 1.5rem; border-radius: 10px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem;
        {{ order.status == 'Completed' ? 'background: #dcfce7; color: #166534;' : '' }}
        {{ order.status == 'Confirmed' ? 'background: #e0f2fe; color: #0369a1;' : '' }}
        {{ order.status == 'Pending' ? 'background: #fef3c7; color: #92400e;' : '' }}
        {{ order.status == 'Cancelled' ? 'background: #fee2e2; color: #991b1b;' : '' }}
    ">
        <div>
            <div style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; opacity: 0.75;">Order Status</div>
            <div style="font-size: 1.3rem; font-weight: 800;">{{ order.status }}</div>
        </div>
        <div style="text-align: right; font-size: 0.9rem; opacity: 0.85;">
            <div>{{ order.orderType }}</div>
            <div>For: <strong>{{ order.reservationDate|date('F j, Y') }}</strong></div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; align-items: start;">
        {# Items Table #}
        <div style="background: #fff; border-radius: 12px; box-shadow: var(--shadow-sm); overflow: hidden;">
            <div style="padding: 1.25rem 1.5rem; background: #fdfaf7; border-bottom: 1px solid rgba(43,27,21,0.08);">
                <h3 style="font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-brown-deep); margin: 0;">Items Ordered</h3>
            </div>
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="text-align: left; font-size: 0.8rem; color: var(--color-text-subtle); text-transform: uppercase; border-bottom: 1px solid rgba(43,27,21,0.08);">
                        <th style="padding: 10px 1.5rem;">Item</th>
                        <th style="padding: 10px 1rem; text-align: center;">Qty</th>
                        <th style="padding: 10px 1rem; text-align: right;">Price</th>
                        <th style="padding: 10px 1.5rem; text-align: right;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in order.items %}
                        <tr style="border-bottom: 1px solid rgba(43,27,21,0.05); font-size: 0.9rem;">
                            <td style="padding: 14px 1.5rem; font-weight: 600; color: var(--color-brown-deep);">{{ item.productName }}</td>
                            <td style="padding: 14px 1rem; text-align: center; color: var(--color-text-muted);">{{ item.quantity }}</td>
                            <td style="padding: 14px 1rem; text-align: right; color: var(--color-text-muted);">₱{{ item.unitPrice }}</td>
                            <td style="padding: 14px 1.5rem; text-align: right; font-weight: 700; color: var(--color-brown-deep);">₱{{ item.subtotal }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr style="border-top: 2px solid rgba(43,27,21,0.1);">
                        <td colspan="3" style="padding: 1rem 1.5rem; text-align: right; font-weight: 700; color: var(--color-brown-deep);">Total Amount</td>
                        <td style="padding: 1rem 1.5rem; text-align: right; font-weight: 800; font-size: 1.2rem; color: var(--color-brown-deep);">₱{{ order.totalAmount }}</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        {# Order Meta #}
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <div style="background: #fff; border-radius: 12px; padding: 1.5rem; box-shadow: var(--shadow-sm); border-top: 4px solid var(--color-yellow);">
                <h4 style="font-family: var(--font-serif); font-size: 1.1rem; color: var(--color-brown-deep); margin-bottom: 1rem;">Customer Details</h4>
                <div style="font-size: 0.9rem; line-height: 2; color: var(--color-text-muted);">
                    <div><strong style="color: var(--color-brown-deep);">{{ order.customerName }}</strong></div>
                    <div>{{ order.customerEmail }}</div>
                    <div>{{ order.customerPhone }}</div>
                </div>
            </div>

            {% if order.specialNotes %}
                <div style="background: #fff8eb; border-left: 4px solid var(--color-yellow); border-radius: 8px; padding: 1.25rem; font-size: 0.9rem;">
                    <div style="font-weight: 700; color: #78350f; margin-bottom: 4px; font-size: 0.8rem; text-transform: uppercase;">Special Instructions</div>
                    <p style="color: #92400e; margin: 0; line-height: 1.6;">{{ order.specialNotes }}</p>
                </div>
            {% endif %}

            <div style="display: flex; gap: 0.75rem; flex-direction: column;">
                <button type="button" onclick="window.print()" class="btn" style="background: #f5ede6; color: var(--color-brown-deep); padding: 0.65rem 1rem; border-radius: 6px; font-weight: 600; font-size: 0.9rem; text-align: center;">🖨 Print Receipt</button>
                <a href="{{ path('app_store_menu') }}" class="btn" style="background: var(--color-yellow); color: var(--color-brown-deep); padding: 0.65rem 1rem; border-radius: 6px; font-weight: 700; font-size: 0.9rem; text-align: center;">Order Again →</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
