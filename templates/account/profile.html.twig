{% extends 'base.html.twig' %}

{% block title %}My Profile - Asentista's Bakery{% endblock %}

{% block body %}
<section style="background: var(--color-brown-deep); color: #fff; padding: 3rem 1.5rem 2rem; text-align: center;">
    <div style="max-width: 700px; margin: 0 auto;">
        <h1 style="font-family: var(--font-serif); font-size: 2.5rem; margin-bottom: 0.5rem;">My Profile</h1>
        <p style="color: #EDE0D4;">Update your personal details and manage your account password.</p>
    </div>
</section>

<section style="max-width: 700px; margin: 3rem auto 5rem; padding: 0 1.5rem;">
    <form action="{{ path('app_account_profile') }}" method="POST">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('account_profile') }}">

        {# Personal Info Card #}
        <div style="background: #fff; border-radius: 12px; padding: 2rem; box-shadow: var(--shadow-sm); margin-bottom: 2rem; border-top: 4px solid var(--color-yellow);">
            <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-brown-deep); margin-bottom: 1.5rem; border-bottom: 1px solid rgba(43,27,21,0.08); padding-bottom: 0.75rem;">Personal Information</h3>

            <div style="margin-bottom: 1.25rem;">
                <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Full Name *</label>
                <input type="text" name="name" value="{{ user.name }}" required style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.95rem;">
            </div>

            <div style="margin-bottom: 1.25rem;">
                <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Email Address</label>
                <input type="email" value="{{ user.email }}" disabled style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid rgba(43,27,21,0.1); border-radius: 6px; font-size: 0.95rem; background: #f9f5f2; color: var(--color-text-muted);">
                <small style="color: var(--color-text-subtle); font-size: 0.8rem; margin-top: 4px; display: block;">Email cannot be changed. Contact support if needed.</small>
            </div>

            <div style="margin-bottom: 0.5rem;">
                <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Phone Number</label>
                <input type="tel" name="phone" value="{{ user.phone }}" placeholder="09XX XXX XXXX" style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.95rem;">
            </div>
        </div>

        {# Password Card #}
        <div style="background: #fff; border-radius: 12px; padding: 2rem; box-shadow: var(--shadow-sm); margin-bottom: 2rem;">
            <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-brown-deep); margin-bottom: 0.5rem; border-bottom: 1px solid rgba(43,27,21,0.08); padding-bottom: 0.75rem;">Change Password</h3>
            <p style="color: var(--color-text-muted); font-size: 0.88rem; margin-bottom: 1.5rem;">Leave blank to keep your current password.</p>

            <div style="margin-bottom: 1.25rem;">
                <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Current Password</label>
                <input type="password" name="current_password" placeholder="Enter current password" style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.95rem;">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div>
                    <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">New Password</label>
                    <input type="password" name="new_password" placeholder="At least 6 characters" style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.95rem;">
                </div>
                <div>
                    <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Confirm New Password</label>
                    <input type="password" name="confirm_password" placeholder="Repeat new password" style="width: 100%; padding: 0.7rem 0.9rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.95rem;">
                </div>
            </div>
        </div>

        <div style="display: flex; gap: 1rem; justify-content: flex-end;">
            <a href="{{ path('app_account_dashboard') }}" style="padding: 0.75rem 1.5rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; color: var(--color-text-muted); font-weight: 600; font-size: 0.95rem; text-decoration: none;">Cancel</a>
            <button type="submit" class="btn" style="background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; padding: 0.75rem 2rem; border-radius: 6px; font-size: 0.95rem;">Save Profile</button>
        </div>
    </form>
</section>
{% endblock %}
