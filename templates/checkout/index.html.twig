{% extends 'base.html.twig' %}

{% block title %}Checkout &amp; Reservation - Asentista's Bakery{% endblock %}

{% block body %}
<section style="background: var(--color-brown-deep); color: #fff; padding: 3rem 1.5rem 2rem; text-align: center;">
    <div style="max-width: 800px; margin: 0 auto;">
        <h1 style="font-family: var(--font-serif); font-size: 2.5rem; margin-bottom: 0.5rem;">Checkout &amp; Fulfillment</h1>
        <p style="color: #EDE0D4;">Select your fulfillment method: In-Store Pickup, Direct Delivery, or Table Reservation.</p>
    </div>
</section>

<section style="max-width: var(--max-width, 1200px); margin: 3rem auto 5rem; padding: 0 1.5rem;">
    <form action="{{ path('app_checkout_index') }}" method="POST">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('checkout') }}">

        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2.5rem; align-items: start;">
            {# Customer & Fulfillment Form #}
            <div style="display: flex; flex-direction: column; gap: 2rem;">
                {# Section 1: Customer Info #}
                <div style="background: #fff; border-radius: 12px; padding: 2rem; box-shadow: var(--shadow-sm);">
                    <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-brown-deep); margin-bottom: 1.5rem; border-bottom: 1px solid rgba(43,27,21,0.08); padding-bottom: 0.75rem;">1. Customer Details</h3>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem;">
                        <div>
                            <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Full Name *</label>
                            <input type="text" name="customer_name" value="{{ user ? user.name : '' }}" required style="width: 100%; padding: 0.65rem 0.85rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.92rem;">
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Contact Phone *</label>
                            <input type="tel" name="customer_phone" value="{{ user ? user.phone : '' }}" required placeholder="09XX XXX XXXX" style="width: 100%; padding: 0.65rem 0.85rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.92rem;">
                        </div>
                    </div>

                    <div>
                        <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Email Address *</label>
                        <input type="email" name="customer_email" value="{{ user ? user.email : '' }}" required style="width: 100%; padding: 0.65rem 0.85rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.92rem;">
                        <small style="color: var(--color-text-subtle); font-size: 0.8rem; margin-top: 4px; display: block;">Your order receipt and pickup details will be sent here.</small>
                    </div>
                </div>

                {# Section 2: Fulfillment & Reservation #}
                <div style="background: #fff; border-radius: 12px; padding: 2rem; box-shadow: var(--shadow-sm);">
                    <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-brown-deep); margin-bottom: 1.5rem; border-bottom: 1px solid rgba(43,27,21,0.08); padding-bottom: 0.75rem;">2. Fulfillment &amp; Date</h3>

                    <div style="margin-bottom: 1.5rem;">
                        <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 8px; color: var(--color-brown-deep);">Order Type *</label>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem;">
                            <label style="display: flex; align-items: center; gap: 8px; padding: 0.85rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 8px; cursor: pointer; font-weight: 500; font-size: 0.9rem;">
                                <input type="radio" name="order_type" value="In-Store Pickup" checked> In-Store Pickup
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; padding: 0.85rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 8px; cursor: pointer; font-weight: 500; font-size: 0.9rem;">
                                <input type="radio" name="order_type" value="Direct Delivery"> Direct Delivery
                            </label>
                            <label style="display: flex; align-items: center; gap: 8px; padding: 0.85rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 8px; cursor: pointer; font-weight: 500; font-size: 0.9rem;">
                                <input type="radio" name="order_type" value="Dine-in Table Booking"> Table Reservation
                            </label>
                        </div>
                    </div>

                    <div style="margin-bottom: 1.5rem;">
                        <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Fulfillment / Reservation Date *</label>
                        <input type="date" name="reservation_date" value="{{ 'now'|date('Y-m-d') }}" min="{{ 'now'|date('Y-m-d') }}" required style="width: 100%; padding: 0.65rem 0.85rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.92rem;">
                    </div>

                    <div>
                        <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Special Instructions or Delivery Notes</label>
                        <textarea name="special_notes" rows="3" placeholder="e.g. Please slice sourdough bread loaf, table by the window for 2, or delivery landmarks..." style="width: 100%; padding: 0.65rem 0.85rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.92rem;"></textarea>
                    </div>
                </div>

                {# Section 3: Payment Method #}
                <div style="background: #fff; border-radius: 12px; padding: 2rem; box-shadow: var(--shadow-sm);">
                    <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-brown-deep); margin-bottom: 1.5rem; border-bottom: 1px solid rgba(43,27,21,0.08); padding-bottom: 0.75rem;">3. Payment Method</h3>
                    <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                        <label style="display: flex; align-items: center; gap: 10px; padding: 1rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 8px; cursor: pointer; font-size: 0.92rem; font-weight: 600;">
                            <input type="radio" name="payment_method" value="COD" checked>
                            <span>Cash on Delivery / Pay at Counter</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 10px; padding: 1rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 8px; cursor: pointer; font-size: 0.92rem; font-weight: 600;">
                            <input type="radio" name="payment_method" value="GCash">
                            <span>GCash (Prompt QR code provided upon order confirmation)</span>
                        </label>
                        <label style="display: flex; align-items: center; gap: 10px; padding: 1rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 8px; cursor: pointer; font-size: 0.92rem; font-weight: 600;">
                            <input type="radio" name="payment_method" value="Bank">
                            <span>Direct Bank Transfer (BDO / BPI)</span>
                        </label>
                    </div>
                </div>
            </div>

            {# Order Summary Sticky Card #}
            <div style="background: #fff; border-radius: 12px; padding: 2rem; box-shadow: var(--shadow-sm); border-top: 4px solid var(--color-yellow); position: sticky; top: 100px;">
                <h3 style="font-family: var(--font-serif); font-size: 1.3rem; color: var(--color-brown-deep); margin-bottom: 1.25rem;">Order Review</h3>

                <div style="max-height: 260px; overflow-y: auto; margin-bottom: 1.25rem; border-bottom: 1px solid rgba(43,27,21,0.08); padding-bottom: 1rem;">
                    {% for item in items %}
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.9rem;">
                            <div>
                                <span style="font-weight: 600; color: var(--color-brown-deep);">{{ item.product.name }}</span>
                                <span style="color: var(--color-text-subtle);"> &times; {{ item.quantity }}</span>
                            </div>
                            <span style="font-weight: 600; color: var(--color-brown-deep);">₱{{ item.subtotal|number_format(2) }}</span>
                        </div>
                    {% endfor %}
                </div>

                <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.95rem; color: var(--color-text-muted);">
                    <span>Subtotal:</span>
                    <span style="font-weight: 600; color: var(--color-brown-deep);">₱{{ total|number_format(2) }}</span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 0.75rem; font-size: 0.95rem; color: var(--color-text-muted);">
                    <span>Preparation Fee:</span>
                    <span style="font-weight: 600; color: #166534;">FREE</span>
                </div>

                <div style="border-top: 1px solid rgba(43,27,21,0.1); margin: 1.25rem 0; padding-top: 1rem; display: flex; justify-content: space-between; align-items: baseline;">
                    <span style="font-size: 1.1rem; font-weight: 700; color: var(--color-brown-deep);">Final Total:</span>
                    <span style="font-size: 1.6rem; font-weight: 800; color: var(--color-brown-deep);">₱{{ total|number_format(2) }}</span>
                </div>

                <button type="submit" class="btn" style="width: 100%; background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; font-size: 1.05rem; padding: 0.95rem; border-radius: 6px; box-shadow: var(--shadow-md);">Confirm &amp; Place Order &rarr;</button>

                <p style="font-size: 0.78rem; color: var(--color-text-subtle); text-align: center; margin-top: 1rem;">By confirming, you agree to receive order notifications via email &amp; SMS.</p>
            </div>
        </div>
    </form>
</section>
{% endblock %}
