{% extends 'base.html.twig' %}

{% block title %}Order Confirmed #{{ order.orderNumber }} - Asentista's Bakery{% endblock %}

{% block body %}
<section style="max-width: 780px; margin: 4rem auto 6rem; padding: 0 1.5rem;">
    <div style="background: #fff; border-radius: 16px; box-shadow: var(--shadow-md); overflow: hidden; border-top: 6px solid #166534;">
        <div style="padding: 3rem 2rem 2rem; text-align: center; background: #fdfaf7; border-bottom: 1px solid rgba(43,27,21,0.08);">
            <div style="width: 70px; height: 70px; background: #dcfce7; color: #166534; font-size: 2rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem;">✓</div>
            <span style="color: #166534; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; font-size: 0.85rem;">Order Successfully Received</span>
            <h1 style="font-family: var(--font-serif); font-size: 2.2rem; color: var(--color-brown-deep); margin: 0.5rem 0;">Thank you, {{ order.customerName }}!</h1>
            <p style="color: var(--color-text-muted); font-size: 1rem;">Your order reference number is: <strong style="color: var(--color-brown-deep); font-family: monospace; font-size: 1.15rem; background: #ede0d4; padding: 2px 8px; border-radius: 4px;">{{ order.orderNumber }}</strong></p>
        </div>

        <div style="padding: 2.5rem 2rem;">
            {# Meta Grid #}
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; background: #fdfaf7; padding: 1.5rem; border-radius: 10px; margin-bottom: 2rem;">
                <div>
                    <div style="font-size: 0.8rem; color: var(--color-text-subtle); text-transform: uppercase; font-weight: 600;">Status</div>
                    <div style="font-weight: 700; color: #d97706; font-size: 1rem; margin-top: 2px;">{{ order.status }}</div>
                </div>
                <div>
                    <div style="font-size: 0.8rem; color: var(--color-text-subtle); text-transform: uppercase; font-weight: 600;">Fulfillment Mode</div>
                    <div style="font-weight: 700; color: var(--color-brown-deep); font-size: 1rem; margin-top: 2px;">{{ order.orderType }}</div>
                </div>
                <div>
                    <div style="font-size: 0.8rem; color: var(--color-text-subtle); text-transform: uppercase; font-weight: 600;">Date Scheduled</div>
                    <div style="font-weight: 700; color: var(--color-brown-deep); font-size: 1rem; margin-top: 2px;">{{ order.reservationDate|date('F j, Y') }}</div>
                </div>
                <div>
                    <div style="font-size: 0.8rem; color: var(--color-text-subtle); text-transform: uppercase; font-weight: 600;">Customer Contact</div>
                    <div style="font-weight: 700; color: var(--color-brown-deep); font-size: 0.95rem; margin-top: 2px;">{{ order.customerPhone }}</div>
                </div>
            </div>

            {% if order.specialNotes %}
                <div style="background: #fff8eb; border-left: 4px solid var(--color-yellow); padding: 1rem; border-radius: 4px; margin-bottom: 2rem; font-size: 0.9rem; color: #78350f;">
                    <strong>Special Instructions:</strong> {{ order.specialNotes }}
                </div>
            {% endif %}

            {# Normalized Line Items #}
            <h3 style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--color-brown-deep); margin-bottom: 1rem;">Purchased Items</h3>
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 2rem;">
                <thead>
                    <tr style="border-bottom: 2px solid rgba(43,27,21,0.1); text-align: left; font-size: 0.85rem; color: var(--color-text-subtle); text-transform: uppercase;">
                        <th style="padding: 8px 0;">Item</th>
                        <th style="padding: 8px 12px; text-align: center;">Price</th>
                        <th style="padding: 8px 12px; text-align: center;">Qty</th>
                        <th style="padding: 8px 0; text-align: right;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in order.items %}
                        <tr style="border-bottom: 1px solid rgba(43,27,21,0.06); font-size: 0.95rem;">
                            <td style="padding: 12px 0; font-weight: 600; color: var(--color-brown-deep);">{{ item.productName }}</td>
                            <td style="padding: 12px; text-align: center; color: var(--color-text-muted);">₱{{ item.unitPrice }}</td>
                            <td style="padding: 12px; text-align: center; color: var(--color-text-muted);">{{ item.quantity }}</td>
                            <td style="padding: 12px 0; text-align: right; font-weight: 700; color: var(--color-brown-deep);">₱{{ item.subtotal }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" style="padding: 16px 0 0; text-align: right; font-weight: 700; font-size: 1.1rem; color: var(--color-brown-deep);">Total Paid / Due:</td>
                        <td style="padding: 16px 0 0; text-align: right; font-weight: 800; font-size: 1.4rem; color: var(--color-brown-deep);">₱{{ order.totalAmount }}</td>
                    </tr>
                </tfoot>
            </table>

            <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <button type="button" onclick="window.print()" class="btn" style="background: #f5ede6; color: var(--color-brown-deep); padding: 0.75rem 1.75rem; border-radius: 6px; font-weight: 600;">Print Receipt</button>
                <a href="{{ path('app_store_index') }}" class="btn" style="background: var(--color-yellow); color: var(--color-brown-deep); padding: 0.75rem 2rem; border-radius: 6px; font-weight: 700;">Return to Storefront</a>
            </div>
        </div>
    </div>
</section>
{% endblock %}
