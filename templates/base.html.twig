<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Asentista's Bakery - Artisan Breads & Pastries{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <style>
        /* Additional polish for Symfony integration */
        .flash-container {
            max-width: var(--max-width, 1200px);
            margin: 1rem auto 0;
            padding: 0 1.5rem;
        }
        .flash-alert {
            padding: 1rem 1.25rem;
            border-radius: 8px;
            margin-bottom: 1rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .flash-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
        .flash-error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
        .flash-info { background: #e0f2fe; color: #075985; border: 1px solid #bae6fd; }
        .nav-cart-badge {
            background: var(--color-yellow, #FFAE34);
            color: var(--color-brown-deep, #2B1B15);
            font-size: 0.75rem;
            font-weight: 700;
            border-radius: 9999px;
            padding: 2px 7px;
            margin-left: 4px;
        }
        .admin-nav-pill {
            background: #92400e;
            color: #fff !important;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
        }
        .staff-nav-pill {
            background: #0369a1;
            color: #fff !important;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="{% if is_granted('ROLE_ADMIN') %}admin-logged-in{% elseif is_granted('ROLE_STAFF') %}staff-logged-in{% endif %}">

    {# Admin Sticky Topbar #}
    {% if is_granted('ROLE_ADMIN') %}
        <div style="background: #2B1B15; color: #EDE0D4; padding: 6px 1.5rem; font-size: 0.85rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,174,52,0.3); flex-wrap: wrap; gap: 0.5rem;">
            <div><strong>Admin Mode:</strong> Logged in as {{ app.user.name }}</div>
            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                <a href="{{ path('app_admin_dashboard') }}" style="color: #FFAE34; font-weight: 600; text-decoration: none;">Dashboard</a>
                <a href="{{ path('app_admin_users') }}" style="color: #EDE0D4; text-decoration: none;">Users & Staff</a>
                <a href="{{ path('app_admin_orders') }}" style="color: #EDE0D4; text-decoration: none;">Orders</a>
                <a href="{{ path('app_admin_products') }}" style="color: #EDE0D4; text-decoration: none;">Products</a>
                <a href="{{ path('app_admin_customers') }}" style="color: #EDE0D4; text-decoration: none;">Customers</a>
            </div>
        </div>
    {# Staff Sticky Topbar #}
    {% elseif is_granted('ROLE_STAFF') %}
        <div style="background: #0c4a6e; color: #e0f2fe; padding: 6px 1.5rem; font-size: 0.85rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(186,230,253,0.3); flex-wrap: wrap; gap: 0.5rem;">
            <div><strong>Staff Mode:</strong> Logged in as {{ app.user.name }}</div>
            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                <a href="{{ path('app_staff_dashboard') }}" style="color: #38bdf8; font-weight: 600; text-decoration: none;">Dashboard</a>
                <a href="{{ path('app_staff_products') }}" style="color: #e0f2fe; text-decoration: none;">Products</a>
                <a href="{{ path('app_staff_profile') }}" style="color: #e0f2fe; text-decoration: none;">Profile</a>
            </div>
        </div>
    {% endif %}

    {# Main Header & Navigation #}
    <header class="site-header" style="background: var(--color-brown-deep); color: #fff; padding: 1rem 1.5rem; position: sticky; top: 0; z-index: 100; box-shadow: var(--shadow-md);">
        <div style="max-width: var(--max-width, 1200px); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <a href="{{ path('app_store_index') }}" style="display: flex; align-items: center; gap: 12px; text-decoration: none;">
                <img src="{{ asset('assets/ASENTISTA FINAL.png') }}" alt="Asentista's Bakery Logo" style="height: 48px; object-fit: contain;">
                <span style="font-family: var(--font-serif); font-size: 1.4rem; font-weight: 700; color: var(--color-yellow);">Asentista's Bakery</span>
            </a>

            <nav style="display: flex; align-items: center; gap: 1.5rem; font-weight: 500; flex-wrap: wrap;">
                <a href="{{ path('app_store_index') }}" style="color: #EDE0D4; text-decoration: none; transition: color 0.2s;">Home</a>
                <a href="{{ path('app_store_menu') }}" style="color: #EDE0D4; text-decoration: none; transition: color 0.2s;">Our Menu</a>

                {# Cart link visible ONLY to customers and guests, NOT admin or staff #}
                {% if not is_granted('ROLE_ADMIN') and not is_granted('ROLE_STAFF') %}
                    <a href="{{ path('app_cart_index') }}" style="color: #EDE0D4; display: flex; align-items: center; text-decoration: none;">
                        Cart
                        <span class="nav-cart-badge" id="nav-cart-count">{{ cart_count|default(0) }}</span>
                    </a>
                {% endif %}

                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_admin_dashboard') }}" class="admin-nav-pill">Admin Dashboard</a>
                    {% elseif is_granted('ROLE_STAFF') %}
                        <a href="{{ path('app_staff_dashboard') }}" class="staff-nav-pill">Staff Dashboard</a>
                        <a href="{{ path('app_staff_profile') }}" style="color: #FFAE34; font-weight: 600; text-decoration: none;">My Profile</a>
                    {% else %}
                        <a href="{{ path('app_account_dashboard') }}" style="color: #FFAE34; font-weight: 600; text-decoration: none;">My Account</a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" style="color: #EDE0D4; font-size: 0.9rem; opacity: 0.85; text-decoration: none;">Logout</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-primary" style="padding: 0.5rem 1.25rem; font-size: 0.85rem; border-radius: 6px; background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; text-decoration: none;">Login / Sign Up</a>
                {% endif %}
            </nav>
        </div>
    </header>

    {# Flash messages banner #}
    {% for label, messages in app.flashes %}
        <div class="flash-container">
            {% for message in messages %}
                <div class="flash-alert flash-{{ label }}">
                    <span>{{ message }}</span>
                    <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; font-size: 1.1rem; cursor: pointer; color: inherit;">&times;</button>
                </div>
            {% endfor %}
        </div>
    {% endfor %}

    {# Page Content #}
    <main>
        {% block body %}{% endblock %}
    </main>

    {# Site Footer #}
    <footer style="background: var(--color-brown-deep); color: #DBC8B6; padding: 3.5rem 1.5rem 2rem; margin-top: 4rem; border-top: 4px solid var(--color-yellow);">
        <div style="max-width: var(--max-width, 1200px); margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2.5rem; margin-bottom: 2.5rem;">
            <div>
                <h3 style="font-family: var(--font-serif); color: var(--color-yellow); font-size: 1.3rem; margin-bottom: 1rem;">Asentista's Bakery</h3>
                <p style="line-height: 1.7; font-size: 0.92rem; color: #EDE0D4;">Crafting European-inspired sourdoughs, artisan crusty loaves, and specialty single-origin coffees every single morning in Sibulan.</p>
            </div>
            <div>
                <h4 style="color: #fff; font-size: 1.1rem; margin-bottom: 1rem;">Store & Cafe Hours</h4>
                <p style="margin-bottom: 0.5rem; font-size: 0.92rem;"><strong>Monday - Friday:</strong> 6:00 AM – 8:00 PM</p>
                <p style="margin-bottom: 0.5rem; font-size: 0.92rem;"><strong>Saturday & Sunday:</strong> 7:00 AM – 9:00 PM</p>
                <p style="color: var(--color-yellow); font-size: 0.9rem;">Fresh batches hot from ovens at 7:00 AM & 3:00 PM</p>
            </div>
            <div>
                <h4 style="color: #fff; font-size: 1.1rem; margin-bottom: 1rem;">Contact & Location</h4>
                <p style="margin-bottom: 0.5rem; font-size: 0.92rem;">Sibulan Commercial Center, Negros Oriental</p>
                <p style="margin-bottom: 0.5rem; font-size: 0.92rem;">Direct Phone: <strong>0994-005-8425</strong></p>
                <p style="font-size: 0.92rem;">Inquiries: <strong>hello@asentista.com</strong></p>
            </div>
        </div>
        <div style="max-width: var(--max-width, 1200px); margin: 0 auto; padding-top: 1.5rem; border-top: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: #8A7A72; flex-wrap: wrap; gap: 0.5rem;">
            <div>&copy; {{ 'now'|date('Y') }} Asentista's Bakery. Built with Symfony 6.4 LTS & Docker.</div>
            <div>Full Relational Database &bull; Production Ready</div>
        </div>
    </footer>

    <script src="{{ asset('js/script.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
