{% extends 'base.html.twig' %}

{% block title %}Reset Password - Asentista's Bakery{% endblock %}

{% block body %}
<section style="max-width: 480px; margin: 4rem auto 6rem; padding: 0 1.5rem;">
    <div style="background: #fff; border-radius: 16px; padding: 2.5rem; box-shadow: var(--shadow-md); border-top: 5px solid var(--color-yellow);">
        <div style="text-align: center; margin-bottom: 2rem;">
            <h1 style="font-family: var(--font-serif); font-size: 1.8rem; color: var(--color-brown-deep); margin-bottom: 0.5rem;">Forgot Password</h1>
            <p style="color: var(--color-text-muted); font-size: 0.9rem;">Enter your registered account email to generate a secure recovery link.</p>
        </div>

        <form action="{{ path('app_forgot_password') }}" method="POST">
            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 600; font-size: 0.88rem; margin-bottom: 6px; color: var(--color-brown-deep);">Your Email Address</label>
                <input type="email" name="email" required style="width: 100%; padding: 0.7rem 0.85rem; border: 1px solid rgba(43,27,21,0.2); border-radius: 6px; font-size: 0.95rem;">
            </div>

            <button type="submit" class="btn" style="width: 100%; background: var(--color-yellow); color: var(--color-brown-deep); font-weight: 700; font-size: 1rem; padding: 0.85rem; border-radius: 6px;">Request Password Reset &rarr;</button>
        </form>

        <div style="text-align: center; margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid rgba(43,27,21,0.08); font-size: 0.9rem; color: var(--color-text-muted);">
            Remembered your credentials? <a href="{{ path('app_login') }}" style="color: var(--color-amber-accessible); font-weight: 700;">Back to Login</a>
        </div>
    </div>
</section>
{% endblock %}
